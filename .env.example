# Copy to .env.local and fill in.
# Use .env.local, not .env — only `.env*.local` is gitignored here.

# Backend URL. Must match the backend's PORT (default 4000).
NEXT_PUBLIC_API_URL=http://localhost:4000

# How long a response is reused before refetching, in milliseconds.
NEXT_PUBLIC_API_CACHE_MS=30000

# Only if API_TOKEN is set on the backend. NEXT_PUBLIC_ values are visible
# in the browser bundle, so this is not a secret.
# NEXT_PUBLIC_API_TOKEN=
